# ── Database ─────────────────────────────────────────────────────────────
# A PostgreSQL connection string. Works with a local Postgres instance,
# or a hosted provider such as Neon (https://neon.tech) or Supabase
# (https://supabase.com) for production/deployment on Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate deploy`.
# A connection pooler (like Neon's default "-pooler" endpoint, or PgBouncer)
# can't hold the advisory lock migrations need, so point this at the
# database directly. If your provider doesn't use a pooler, this can be
# the same value as DATABASE_URL. On Neon, use the "_UNPOOLED" / non-pooling
# connection string from your project's connection details.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nexora?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app. Used to build links (e.g. password reset
# emails). Set this to your real domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret required to call POST /api/setup/seed, a one-time bootstrap endpoint
# that populates a fresh database with the starter catalog and an admin
# account. Generate one with `openssl rand -hex 24`. Only needed the first
# time you set up a new database; safe to remove afterward.
SETUP_SECRET=""

# Set to "true" to take the storefront offline behind a "back soon" page for
# everyone except signed-in admins (who can still use /admin to manage the
# store). Set back to "false" (or remove) to reopen the site. On Vercel this
# requires a redeploy of the current build to take effect either way.
MAINTENANCE_MODE="false"

# ── Email (Resend) ───────────────────────────────────────────────────────
# Get a free API key from https://resend.com/api-keys. Leave blank to run
# without real email — "Forgot password" links are still generated but
# only logged server-side instead of being emailed (fine for local dev,
# not for real customers).
RESEND_API_KEY=""
# Sender address. Resend's shared "onboarding@resend.dev" address works
# immediately with no setup, for getting started; once you verify your own
# domain in the Resend dashboard, switch this to an address on it (e.g.
# "EXORASTORE <noreply@yourdomain.com>") for better deliverability.
EMAIL_FROM="EXORASTORE <onboarding@resend.dev>"

# ── Payments (Razorpay) ──────────────────────────────────────────────────
# Get test-mode keys from https://dashboard.razorpay.com/app/keys (no real
# money moves in test mode). Leave these blank to run the app without
# checkout enabled — orders are still created with a "payment pending"
# status instead of a fake "payment successful" state.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Signing secret configured on the webhook endpoint in the Razorpay
# dashboard (Settings → Webhooks), pointed at /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=""
# Same value as RAZORPAY_KEY_ID, exposed to the browser so the checkout
# widget can open. Safe to expose — it is a public identifier, not a secret.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── Image storage (Cloudinary) ───────────────────────────────────────────
# Get these from https://cloudinary.com/console. Leave blank to fall back
# to local disk storage under /public/uploads for local development —
# fine for dev, but not durable on a serverless deployment like Vercel.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Order sync (Google Sheets) ────────────────────────────────────────────
# Optional. Pushes every newly-paid order to a Google Sheet via a Google
# Apps Script "Web App" deployment (no Google Cloud project needed - see
# README section on Google Sheets sync). Leave both blank to skip this
# entirely; a failed/missing sync never blocks an order.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_SECRET=""

# ── Ad tracking (Meta Pixel) ──────────────────────────────────────────────
# Optional. Get this from Meta Events Manager (business.facebook.com ->
# Events Manager -> your pixel -> Settings). Not a secret - it's visible
# in every page's source anyway. Leave blank to skip the pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=""

# Optional. Enables the Meta Conversions API - a server-side Purchase event
# sent the moment an order is marked paid, so sales aren't lost to ad
# blockers or Safari's tracking prevention (which routinely block the
# browser pixel above). Get it from Events Manager -> your pixel ->
# Settings -> Conversions API -> "Generate access token". This IS a
# secret - never expose it with a NEXT_PUBLIC_ prefix. Leave blank to skip.
META_CONVERSIONS_API_ACCESS_TOKEN=""
